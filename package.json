{
    "name": "allicord",
    "private": "true",
    "version": "0.1.0",
    "description": "Allicord is the softest Discord client mod, by Alliance, built on Equicord.",
    "homepage": "https://github.com/FlibatsUniverse/Allicord#readme",
    "bugs": {
        "url": "https://github.com/FlibatsUniverse/Allicord/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlibatsUniverse/Allicord.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "Alliance",
    "scripts": {
        "build": "bun scripts/build/build.mjs",
        "buildStandalone": "bun run build --standalone",
        "buildWeb": "bun scripts/build/buildWeb.mjs",
        "buildWebStandalone": "bun run buildWeb --standalone",
        "buildReporter": "bun run buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "bun run build --reporter",
        "watch": "bun run build --watch",
        "dev": "bun run watch",
        "watchWeb": "bun run buildWeb --watch",
        "generateDevsList": "bun scripts/generateDevsList.ts",
        "generatePluginJson": "bun scripts/generatePluginList.ts",
        "generateEquicordPluginJson": "bun scripts/generatePluginList.ts --equicord",
        "generateVencordPluginJson": "bun scripts/generatePluginList.ts --vencord",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "bun scripts/runInstaller.mjs -- --install",
        "uninject": "bun scripts/runInstaller.mjs -- --uninstall",
        "repair": "bun scripts/runInstaller.mjs -- --repair",
        "lint": "eslint",
        "lint-styles": "stylelint \"src/**/*.css\" --ignore-pattern src/userplugins",
        "lint-styles:fix": "bun run lint-styles --fix",
        "lint:fix": "bun run lint --fix",
        "lint:intl": "bun scripts/lintIntl.mjs",
        "lint:patches": "bun scripts/lintPatches.mjs",
        "test": "bun run buildStandalone && bun run testTsc && bun run lint:fix && bun run lint-styles && bun run lint:intl && bun run lint:patches && bun run generatePluginJson",
        "testWeb": "bun run lint:fix && bun run buildWeb && bun run testTsc",
        "testTsc": "tsc --noEmit"
    },
    "dependencies": {
        "@ffmpeg/ffmpeg": "^0.12.10",
        "@ffmpeg/util": "^0.12.1",
        "@intrnl/xxhash64": "^0.1.2",
        "@song-spotlight/api": "^2.2.0",
        "@streamparser/json": "^0.0.22",
        "@vap/core": "0.0.12",
        "@vap/shiki": "0.10.5",
        "fflate": "^0.8.3",
        "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3",
        "gifuct-js": "^2.1.2",
        "idb": "8.0.3",
        "jsqr": "1.4.0",
        "monaco-editor": "^0.55.1",
        "nanoid": "^5.1.16",
        "native-file-system-adapter": "^3.0.1",
        "virtual-merge": "^1.0.1",
        "yaml-js": "^0.3.1"
    },
    "devDependencies": {
        "@electron/asar": "^4.2.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/chrome": "^0.2.0",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.0.1",
        "@types/react": "19.1.0",
        "@types/react-dom": "19.1.0",
        "@types/yazl": "^3.3.1",
        "@vencord/discord-types": "file:packages/discord-types",
        "diff": "^9.0.0",
        "esbuild": "^0.28.1",
        "eslint": "10.6.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-header": "^1.2.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "highlight.js": "11.11.1",
        "html-minifier-terser": "^7.2.0",
        "md5": "^2.3.0",
        "moment": "^2.22.2",
        "p-limit": "^7.3.0",
        "puppeteer-core": "^25.2.1",
        "standalone-electron-types": "^41.2.1",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "svgo": "^4.0.1",
        "ts-patch": "^3.3.0",
        "ts-pattern": "^5.9.0",
        "type-fest": "^5.7.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "typescript-transform-paths": "^3.5.6",
        "zip-local": "^0.3.5"
    },
    "workspaces": [
        "packages/*"
    ],
    "trustedDependencies": [
        "esbuild"
    ],
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": ">=1.3.14"
    }
}
